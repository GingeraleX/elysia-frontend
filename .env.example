# ============================================================
# FRONTEND ENVIRONMENT EXAMPLE — frontend/.env.example
# Copy this file to frontend/.env.local and fill in values.
# NEVER commit frontend/.env.local to git.
# ============================================================

# ────────────────────────────────────────────────────────────
# SERVER
# ────────────────────────────────────────────────────────────

PORT=3001
NODE_ENV=development

# ────────────────────────────────────────────────────────────
# BACKEND CONNECTION (required)
# ────────────────────────────────────────────────────────────

# Used by: host.ts, ProcessingModeSection, api calls
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# Used by: lib/api-client.ts, hooks/useSystemConfig.ts, settings hooks
NEXT_PUBLIC_API_URL=http://localhost:3000

# Default API call timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=10000

# ────────────────────────────────────────────────────────────
# STATIC / EXPORT BUILD
# ────────────────────────────────────────────────────────────

# Set to "true" when building as static export (next export / GitHub Pages)
# When true: host.ts uses "" as base URL (relative) and "/static/" as asset prefix
NEXT_PUBLIC_IS_STATIC=false

# ────────────────────────────────────────────────────────────
# MOCK MODE (development only)
# ────────────────────────────────────────────────────────────

# Set to "true" to enable the in-app mock mode toggle (bottom-right corner).
# When enabled AND the toggle is switched on, all API calls are intercepted
# and served from fixture data in lib/mock-data.ts — no backend required.
# Has zero effect in production builds where this flag is absent.
NEXT_PUBLIC_MOCK_MODE=false

# ────────────────────────────────────────────────────────────
# ANALYTICS (optional)
# ────────────────────────────────────────────────────────────

# Google Analytics 4 measurement ID (leave empty to disable)
# Used by: app/layout.tsx via @next/third-parties GoogleAnalytics
NEXT_PUBLIC_G_KEY=

# ────────────────────────────────────────────────────────────
# AUTH (NextAuth — if added in future)
# ────────────────────────────────────────────────────────────

# Required if using NextAuth.js
# NEXTAUTH_URL=http://localhost:3001
# NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ────────────────────────────────────────────────────────────
# FEATURE FLAGS (optional)
# ────────────────────────────────────────────────────────────

# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false
# NEXT_PUBLIC_APP_NAME=Elysia
# NEXT_PUBLIC_APP_VERSION=0.2.5

